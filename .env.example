# WhatsApp Backup to Chatwoot — configuración compartida de los módulos.
#
# En la primera ejecución, el onboarding pregunta el tipo de instalación y
# completa lo necesario. También podés editar este archivo manualmente.

# Estado del onboarding: el programa lo completa; normalmente no se edita.
SETUP_MODE=
ONBOARDING_DONE=

# ---------- Servidor (SSH) — túnel a Postgres y subida de adjuntos ----------
# SSH_KEY acepta la ruta del archivo .pem O una carpeta donde buscarlo:
#   SSH_KEY=C:\Carpeta\llave.pem   o pegar  C:\Carpeta  cuando lo pregunte
SSH_HOST=
SSH_USER=
SSH_KEY=

# Puertos del túnel SSH (candados por defecto: la base del servidor escucha en
# 5432 y en esta PC se ve como 127.0.0.1:15432). Normalmente no hay que tocarlos.
TUNNEL_LOCAL_PORT=15432
# Host de PostgreSQL visto DESDE el servidor SSH. En Docker oficial suele ser
# 127.0.0.1 porque Compose publica el puerto solamente en localhost.
TUNNEL_REMOTE_HOST=127.0.0.1
TUNNEL_REMOTE_PORT=5432

# ---------- Módulo 2 (opción 2 del menú): importar CONTACTOS (API de Chatwoot) ----------
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_TOKEN=
DEFAULT_COUNTRY_CODE=

# Solo se usan al importar un archivo .vcf (vCard) — se piden/guardan solos
DEFAULT_AREA_CODE=

# ---------- Módulo 4 (opción 4 del menú): importar CHATS (directo a Postgres) ----------
# Conexión a la base (¡NO la API!). Con el túnel del menú abierto:
#   postgres://chatwoot:clave@127.0.0.1:15432/chatwoot_production
DATABASE_URL=

# Cuenta, inbox y agente destino (los lista el reconocimiento — opción 2 del
# importador de chats. Si faltan, se preguntan al importar)
ACCOUNT_ID=
INBOX_ID=
AGENT_USER_ID=

# Carpeta del export generado por el módulo 1 con formato "Chatwoot"
# (la que contiene chatwoot_export.json y attachments/)
EXPORT_DIR=

# Carpeta LOCAL donde el PASO 2 deja los adjuntos con la estructura de Chatwoot
# (xx/yy/clave). El PASO 3 la sube entera al storage del servidor.
STORAGE_SERVICE=local
STORAGE_ROOT=

# Pausa en milisegundos entre chat y chat (0 = sin pausa; subir a 200 si hay
# agentes trabajando y se quiere bajar la carga del servidor)
IMPORT_PAUSE_MS=0
