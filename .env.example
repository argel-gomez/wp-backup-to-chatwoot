# WhatsApp Backup to Chatwoot — shared module configuration.
#
# On first run, onboarding asks about the installation and fills in the required
# values. You may also edit this file manually.

# Onboarding state. The program manages these values automatically.
SETUP_MODE=
ONBOARDING_DONE=

# ---------- Server (SSH): PostgreSQL tunnel and attachment upload ----------
# SSH_KEY accepts either a .pem file path or a folder to search:
#   SSH_KEY=C:\Keys\server.pem   or enter C:\Keys when prompted
SSH_HOST=
SSH_USER=
SSH_KEY=

# SSH tunnel ports. By default the server database listens on 5432 and this
# computer accesses it at 127.0.0.1:15432. Usually no changes are needed.
TUNNEL_LOCAL_PORT=15432
# PostgreSQL host as seen from the SSH server. Official Docker Compose setups
# commonly use 127.0.0.1 because the port is published only on localhost.
TUNNEL_REMOTE_HOST=127.0.0.1
TUNNEL_REMOTE_PORT=5432

# ---------- Module 2 (main menu option 2): import CONTACTS through the API ----------
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_TOKEN=
DEFAULT_COUNTRY_CODE=

# Used only for vCard imports and requested automatically when needed.
DEFAULT_AREA_CODE=

# ---------- Module 4 (main menu option 4): import CHATS directly into PostgreSQL ----------
# Database connection, not the API. With the menu tunnel open:
#   postgres://chatwoot:password@127.0.0.1:15432/chatwoot_production
DATABASE_URL=

# Target account, inbox, and agent. The read-only inspection lists these values,
# and the importer asks for any missing value.
ACCOUNT_ID=
INBOX_ID=
AGENT_USER_ID=

# Export folder generated by module 1 in Chatwoot format. It must contain
# chatwoot_export.json and attachments/.
EXPORT_DIR=

# Local folder where step 2 writes attachments using Chatwoot's xx/yy/key
# layout. Step 3 uploads this complete folder to server storage.
STORAGE_SERVICE=local
STORAGE_ROOT=

# Delay in milliseconds between chats. Use 0 for no delay, or increase it (for
# example, to 200) to reduce server load while agents are working.
IMPORT_PAUSE_MS=0
